{
  "name": "plexify-planner-v2",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Modern productivity planner with task management, time tracking, and pull request monitoring",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:extension": "npm run build && npm run copy-manifest",
    "build:watch": "tsc -b && vite build --watch",
    "copy-manifest": "cp public/manifest.json dist/",
    "lint": "eslint .",
    "preview": "vite preview",
    "serve": "vite preview --port 3000"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.83.0",
    "@types/pouchdb": "^6.4.2",
    "axios": "1.12.0",
    "framer-motion": "^10.13.0",
    "lucide-react": "^0.344.0",
    "luxon": "^3.4.4",
    "material-icons": "^1.13.8",
    "moment": "^2.29.4",
    "normalize.css": "^8.0.1",
    "pouchdb": "^8.0.1",
    "query-string": "^8.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.22.2",
    "react-select": "^5.7.4",
    "slugify": "^1.6.6",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/chrome": "^0.1.1",
    "@types/luxon": "^3.3.7",
    "@types/node": "^24.0.14",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^9.0.7",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "7.1.11"
  }
}
