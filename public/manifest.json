{
  "manifest_version": 3,
  "key": "",
  "name": "Plexify Planner",
  "version": "2.0.0",
  "description": "Modern productivity planner with task management, time tracking, and pull request monitoring",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Plexify Planner"
  },
  "permissions": [
    "storage",
    "activeTab",
    "identity",
    "cookies",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:8080/*",
    "http://localhost:7777/*",
    "http://localhost:8081/*"
  ],
  
  
  "web_accessible_resources": [
    {
      "resources": ["*"],
      "matches": ["<all_urls>"]
    }
  ]
}